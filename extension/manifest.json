{
  "manifest_version": 3,
  "name": "VRChat 1080p 動画リンク変換",
  "version": "1.1.0",
  "description": "YouTubeのURLをVRChatで安定再生できる1080p高画質または標準形式に自動変換し、ワンクリックでコピーします。",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "clipboardWrite",
    "nativeMessaging"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "*://*.trycloudflare.com/*",
    "*://*.onrender.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
